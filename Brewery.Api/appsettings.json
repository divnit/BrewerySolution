{
  "OpenBrewery": {
    "BaseUrl": "https://api.openbrewerydb.org/v1/",
    "PerPage": 200,
    "CacheMinutes": 10
  },
  "Persistence": {
    "UseSqlite": true,
    "SqliteConnection": "Data Source=breweries.db"
  },
  "Security": {
    "EnableApiKey": false,
    "ApiKey": "replace-with-your-key"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
